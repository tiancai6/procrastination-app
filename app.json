{
  "expo": {
    "name": "日迹",
    "slug": "dailytrace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.example.procrastination",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.procrastination",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22D3EE"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以选择头像图片",
          "cameraPermission": "允许访问相机以拍摄头像图片"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "dailytrace",
    "extra": {
      "eas": {
        "projectId": "7c582744-933c-4b84-b7bd-4632f0685461"
      }
    }
  }
}
